#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ -z "$1" ] || [ "${1#-}" != "$1" ]; then
  echo "Usage: $0 <ssh-host-alias-or-destination>" >&2
  exit 2
fi

exec ssh -N -T \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -L 127.0.0.1:8765:127.0.0.1:8765 \
  -L 127.0.0.1:9090:127.0.0.1:9090 \
  -L 127.0.0.1:4000:127.0.0.1:4000 \
  -L 127.0.0.1:51821:127.0.0.1:51821 \
  -L 127.0.0.1:14096:127.0.0.1:4096 \
  -L 127.0.0.1:20128:127.0.0.1:20128 \
  -L 127.0.0.1:20129:127.0.0.1:20129 \
  -L 127.0.0.1:20132:127.0.0.1:20132 \
  "$1"
