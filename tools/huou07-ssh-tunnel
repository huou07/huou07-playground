#!/bin/sh
set -eu

mode=all
dashboard_port=$(python3 "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/web/private_services.py" --port dashboard backend_port)
host=
usage() {
  echo "Usage: $0 [--dashboard-port <local-port>] [--omniroute-only] <ssh-host-alias-or-destination>" >&2
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dashboard-port)
      if [ "$#" -lt 2 ]; then usage; exit 2; fi
      dashboard_port=$2
      shift 2
      ;;
    --omniroute-only)
      if [ "$mode" != all ]; then usage; exit 2; fi
      mode=omniroute
      shift
      ;;
    *)
      if [ -n "$host" ] || [ "${1#-}" != "$1" ]; then usage; exit 2; fi
      host=$1
      shift
      ;;
  esac
done
case "$dashboard_port" in
  ''|*[!0-9]*) usage; exit 2 ;;
esac
if [ "${#dashboard_port}" -gt 5 ] || [ "$dashboard_port" -lt 1 ] || [ "$dashboard_port" -gt 65535 ]; then
  usage
  exit 2
fi
if [ "$mode" = omniroute ] && [ "$dashboard_port" != "$(python3 "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/web/private_services.py" --port dashboard backend_port)" ]; then usage; exit 2; fi
if [ -z "$host" ]; then usage; exit 2; fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
forward_specs=$(python3 "$root/web/private_services.py" --ssh-forwards "$mode" --dashboard-port "$dashboard_port")
set --
while IFS=: read -r local_port remote_port; do
  [ -n "$local_port" ] || continue
  set -- "$@" -L "127.0.0.1:$local_port:127.0.0.1:$remote_port"
done <<EOF_PORTS
$forward_specs
EOF_PORTS
set -- "$@" "$host"
exec ssh -N -T \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  "$@"
