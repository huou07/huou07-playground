[Unit]
Description=OmniRoute (huou07 user service)

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
EnvironmentFile=%h/.config/omniroute/omniroute.env
RuntimeDirectory=huou07-omniroute
RuntimeDirectoryMode=0700
ExecStartPre=/usr/local/libexec/huou07-omniroute/prepare.sh
ExecStartPre=/usr/bin/podman run --replace --rm --detach --name huou07-omniroute-redis --pod huou07-omniroute --security-opt=no-new-privileges --cap-drop=all --log-driver=journald docker.io/library/redis:8.6.5-alpine redis-server --save "" --appendonly no --loglevel warning
ExecStartPre=/usr/local/libexec/huou07-omniroute/wait-redis.sh
ExecStart=/usr/bin/podman run --replace --rm --name huou07-omniroute-app --pod huou07-omniroute --volume %h/.local/share/omniroute/data:/app/data --security-opt=no-new-privileges --cap-drop=all --log-driver=journald --env ALLOW_API_KEY_REVEAL --env API_HOST --env API_KEY_SECRET --env API_PORT --env DATA_DIR --env DASHBOARD_PORT --env INITIAL_PASSWORD --env JWT_SECRET --env LIVE_WS_PORT --env MACHINE_ID_SALT --env NODE_ENV --env OMNIROUTE_CLI_SALT --env OMNIROUTE_MEMORY_MB --env OMNIROUTE_WS_BRIDGE_SECRET --env REDIS_URL --env REQUIRE_API_KEY docker.io/diegosouzapw/omniroute:3.8.51
ExecStartPost=/usr/local/libexec/huou07-omniroute/wait-ready.sh
ExecStop=/usr/bin/podman stop --time 40 huou07-omniroute-app
ExecStopPost=-/usr/bin/podman stop --time 10 huou07-omniroute-redis
ExecStopPost=-/usr/bin/podman pod rm --force huou07-omniroute
Restart=on-failure
RestartSec=5s
TimeoutStartSec=320s
TimeoutStopSec=55s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=10G
CPUQuota=200%
TasksMax=512
LimitNOFILE=8192
Delegate=yes

[Install]
WantedBy=default.target
