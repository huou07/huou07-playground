[Unit]
Description=OmniRoute
Requires=omniroute-pod.service omniroute-redis.service
After=omniroute-pod.service omniroute-redis.service

[Container]
Image=docker.io/diegosouzapw/omniroute:3.8.51
ContainerName=huou07-omniroute
Pod=omniroute.pod
EnvironmentFile=%h/.config/omniroute/omniroute.env
# Published pod ports reach the container interface, not its private loopback.
Environment=API_HOST=0.0.0.0
Environment=LIVE_WS_HOST=0.0.0.0
Environment=LIVE_WS_ALLOWED_ORIGINS=http://10.8.0.1:20128
Volume=huou07-omniroute-data:/app/data
LogDriver=journald
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
TimeoutStopSec=50s
MemoryMax=3G

[Install]
WantedBy=default.target
