[Unit]
Description=OpenCode Web
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/huou07-playground/opencode-web.env
ExecStart=%h/.local/bin/opencode web --hostname 127.0.0.1 --port 4097
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=default.target
