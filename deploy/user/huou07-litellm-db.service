[Unit]
Description=LiteLLM PostgreSQL (huou07 user service)
Before=huou07-litellm.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=%t
EnvironmentFile=%h/.config/litellm/postgres.env
RuntimeDirectory=huou07-litellm
RuntimeDirectoryMode=0700
ExecStartPre=/usr/local/libexec/huou07-litellm/prepare.sh
ExecStart=/usr/bin/podman run --replace --rm --name huou07-litellm-db --pod huou07-litellm --volume huou07-litellm-postgres:/var/lib/postgresql/data --security-opt=no-new-privileges --log-driver=journald --env POSTGRES_USER --env POSTGRES_PASSWORD --env POSTGRES_DB docker.io/library/postgres:16
ExecStartPost=/usr/local/libexec/huou07-litellm/wait-postgres.sh
ExecStop=/usr/bin/podman stop --time 30 huou07-litellm-db
ExecStopPost=-/usr/bin/podman pod rm --force huou07-litellm
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=1G
CPUQuota=100%
TasksMax=256
LimitNOFILE=4096
Delegate=yes

[Install]
WantedBy=default.target
