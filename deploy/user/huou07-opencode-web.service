[Unit]
Description=OpenCode Web (huou07 user service)

[Service]
Type=simple
WorkingDirectory=%h/Projects
EnvironmentFile=%h/.config/opencode/web.env
ExecStart=%h/.opencode/bin/opencode web --pure --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=4G
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=default.target
