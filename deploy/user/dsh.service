[Unit]
Description=DeepSeek Harness Web
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects
Environment=HOME=%h
Environment=DSH_HOME=%h/.dsh
Environment=CODEX_HOME=%h/.codex
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/share/huou07-playground/dsh-dashboard-launcher.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=default.target
