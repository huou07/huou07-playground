[Unit]
Description=huou07 LiteLLM gateway
Requires=huou07-litellm-db.service
After=huou07-litellm-db.service

[Service]
Type=simple
User=huou07-litellm
Group=huou07-litellm
WorkingDirectory=/var/lib/huou07-litellm
Environment=HOME=/var/lib/huou07-litellm
Environment=XDG_RUNTIME_DIR=/run/huou07-litellm
Environment=STORE_MODEL_IN_DB=True
EnvironmentFile=/etc/huou07-litellm/litellm.env
RuntimeDirectory=huou07-litellm
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/podman run --replace --rm --name huou07-litellm-proxy --network huou07-litellm --publish 127.0.0.1:4000:4000 --memory=2g --cpus=2 --security-opt=no-new-privileges --cap-drop=all --log-driver=journald --env LITELLM_MASTER_KEY --env LITELLM_SALT_KEY --env DATABASE_URL --env STORE_MODEL_IN_DB ghcr.io/berriai/litellm:v1.103.1
ExecStop=/usr/bin/podman stop --time 30 huou07-litellm-proxy
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/huou07-litellm /run/huou07-litellm
MemoryMax=2G
CPUQuota=200%
TasksMax=512
LimitNOFILE=8192
Delegate=yes

[Install]
WantedBy=multi-user.target
