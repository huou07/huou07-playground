[Unit]
Description=huou07 OpenCode web workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huou07-opencode
Group=huou07-opencode
SupplementaryGroups=huou07-opencode-workspaces
WorkingDirectory=/srv/huou07-opencode-workspaces
Environment=HOME=/var/lib/huou07-opencode
Environment=XDG_CONFIG_HOME=/var/lib/huou07-opencode/config
Environment=XDG_DATA_HOME=/var/lib/huou07-opencode/data
Environment=XDG_STATE_HOME=/var/lib/huou07-opencode/state
Environment=XDG_CACHE_HOME=/var/lib/huou07-opencode/cache
EnvironmentFile=/etc/huou07-playground/opencode-web.env
ExecStart=/usr/local/libexec/huou07-opencode/opencode web --pure --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/huou07-opencode /srv/huou07-opencode-workspaces
MemoryMax=4G
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
