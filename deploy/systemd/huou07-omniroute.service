[Unit]
Description=huou07 OmniRoute AI gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huou07-omniroute
Group=huou07-omniroute
WorkingDirectory=/var/lib/huou07-omniroute
Environment=HOME=/var/lib/huou07-omniroute
Environment=XDG_RUNTIME_DIR=/run/huou07-omniroute
EnvironmentFile=/etc/huou07-omniroute/omniroute.env
RuntimeDirectory=huou07-omniroute
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/local/libexec/huou07-omniroute/prepare.sh
ExecStartPre=/usr/bin/podman run --replace --rm --detach --name huou07-omniroute-redis --pod huou07-omniroute --security-opt=no-new-privileges --cap-drop=all --log-driver=journald docker.io/library/redis:8.6.5-alpine redis-server --save "" --appendonly no --loglevel warning
ExecStartPre=/usr/local/libexec/huou07-omniroute/wait-redis.sh
ExecStart=/usr/bin/podman run --replace --rm --name huou07-omniroute-app --pod huou07-omniroute --volume /var/lib/huou07-omniroute/data:/app/data --security-opt=no-new-privileges --cap-drop=all --log-driver=journald --env ALLOW_API_KEY_REVEAL --env API_KEY_SECRET --env API_PORT --env DATA_DIR --env DASHBOARD_PORT --env INITIAL_PASSWORD --env JWT_SECRET --env LIVE_WS_PORT --env MACHINE_ID_SALT --env NODE_ENV --env OMNIROUTE_CLI_SALT --env OMNIROUTE_MEMORY_MB --env OMNIROUTE_WS_BRIDGE_SECRET --env REDIS_URL --env REQUIRE_API_KEY docker.io/diegosouzapw/omniroute:3.8.51
ExecStartPost=/usr/local/libexec/huou07-omniroute/wait-ready.sh
ExecStop=/usr/bin/podman stop --time 40 huou07-omniroute-app
ExecStopPost=-/usr/bin/podman stop --time 10 huou07-omniroute-redis
ExecStopPost=-/usr/bin/podman pod rm --force huou07-omniroute
Restart=on-failure
RestartSec=5
TimeoutStartSec=320
TimeoutStopSec=55
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/huou07-omniroute /run/huou07-omniroute
MemoryMax=10G
CPUQuota=200%
TasksMax=512
LimitNOFILE=8192
Delegate=yes

[Install]
WantedBy=multi-user.target
