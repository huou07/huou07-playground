[Unit]
Description=huou07 playground personal dashboard
After=network.target huou07-wg-easy.service

[Service]
Type=simple
User=huou07-playground
Group=huou07-playground
SupplementaryGroups=huou07-dsh-link
WorkingDirectory=/opt/huou07-playground/current/web
Environment=HOST=127.0.0.1
Environment=PORT=8765
Environment=APPS_FILE=/var/lib/huou07-playground/apps.json
ExecStart=/usr/bin/python3 /opt/huou07-playground/current/web/app.py
Restart=on-failure
RestartSec=2s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
StateDirectory=huou07-playground
StateDirectoryMode=0750
ReadOnlyPaths=/proc /sys

[Install]
WantedBy=multi-user.target
