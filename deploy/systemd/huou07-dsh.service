[Unit]
Description=DeepSeek Harness private agent workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=huou07-dsh-link
RuntimeDirectory=huou07-dsh-link
RuntimeDirectoryMode=0750
WorkingDirectory=/srv/huou07-dsh-workspaces
Environment=HOME=/var/lib/huou07-dsh
Environment=DSH_HOME=/var/lib/huou07-dsh/dsh
Environment=XDG_CONFIG_HOME=/var/lib/huou07-dsh/config
Environment=XDG_DATA_HOME=/var/lib/huou07-dsh/data
Environment=XDG_STATE_HOME=/var/lib/huou07-dsh/state
Environment=XDG_CACHE_HOME=/var/lib/huou07-dsh/cache
Environment=PATH=/opt/huou07-dsh/node/bin:/opt/huou07-dsh/app/node_modules/.bin:/usr/local/libexec/huou07-opencode:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/libexec/huou07-dsh/launcher.py
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/huou07-dsh /srv/huou07-dsh-workspaces /run/huou07-dsh-link
MemoryMax=4G
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
